{
  // server/ was covered by NO tsconfig: tsconfig.app.json includes only src/,
  // tsconfig.node.json only vite.config.ts, and tsx strips types without
  // checking them. `npm run typecheck` now covers the server.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["server"]
}
