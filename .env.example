
# === LANA REGISTRATION ===
LANA_REGISTER_API_KEY=CHANGE_ME
# Lana Registrar base URL (paths /functions/v1/* are appended by the app)
REGISTRAR_URL=https://lanatrace.us

# === LANA ONLINE SHOP (SPEC §9.3) ===
# Broker that opens the gateway session and publishes the order events.
# Unset ⇒ POST /api/orders answers 503 ORDERING_UNAVAILABLE (the buy buttons
# still show; checkout says ordering is unavailable). Turn it on only after
# the broker lists this portal in its PORTAL_ORIGINS.
# SHOP_ORDERS_URL=https://shop.lanapays.us
PORTAL_ID=lanaeco-farm
PORTAL_PUBLIC_URL=https://www.lanaeco.farm
# How many different products one order may carry (default 30; 1 = one product per order).
# SHOP_MAX_ITEMS=30

# Dev-only overrides — MUST stay out of every VPS .env. The gate is the relay
# URL, not NODE_ENV (our compose never sets it): LANA_RELAYS_OVERRIDE is
# honoured only for loopback URLs, and LANA_TRUSTED_SIGNERS_OVERRIDE — the
# money-truth trust anchor — only together with such a relay.
# LANA_RELAYS_OVERRIDE=ws://localhost:7777
# LANA_TRUSTED_SIGNERS_OVERRIDE=<brain test hex>
# KIND_38888_PUBKEY=<test system-params hex>
# LANA_DB_PATH=/tmp/lanaeco-farm-e2e.db
